# =============================================================================
# APS Dream Home - MySQL 8.0 server configuration
# Custom overrides mounted to /etc/mysql/conf.d/app.cnf
# =============================================================================

[mysqld]
# ---------------------------------------------------------------------------
# Character set & collation
# ---------------------------------------------------------------------------
character-set-server           = utf8mb4
collation-server               = utf8mb4_unicode_ci
default-character-set          = utf8mb4
init-connect                   = 'SET NAMES utf8mb4'

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
bind-address                   = 0.0.0.0
port                           = 3306
max_connections                = 300
max_connect_errors             = 1000000
wait_timeout                   = 28800
interactive_timeout            = 28800

# ---------------------------------------------------------------------------
# InnoDB - tuned for ~1-2GB buffer pool, typical real-estate CRM workload
# ---------------------------------------------------------------------------
default-storage-engine         = InnoDB
innodb_buffer_pool_size        = 512M
innodb_log_file_size           = 128M
innodb_log_buffer_size         = 16M
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table          = 1
innodb_flush_method            = O_DIRECT
innodb_thread_concurrency      = 0
innodb_read_io_threads         = 8
innodb_write_io_threads        = 8

# ---------------------------------------------------------------------------
# Query / temporary tables
# ---------------------------------------------------------------------------
tmp_table_size                 = 64M
max_heap_table_size            = 64M
table_open_cache               = 2000
table_definition_cache         = 1400
sort_buffer_size               = 4M
read_buffer_size               = 2M
read_rnd_buffer_size           = 8M
join_buffer_size               = 4M
thread_cache_size              = 16
thread_stack                   = 256K

# ---------------------------------------------------------------------------
# Slow query log (good for first production days)
# ---------------------------------------------------------------------------
slow_query_log                 = 1
slow_query_log_file            = /var/lib/mysql/mysql-slow.log
long_query_time                = 2
log_queries_not_using_indexes  = 0

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
skip-name-resolve
local-infile                   = 0
sql_mode                       = STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
log_error                      = /var/lib/mysql/mysql-error.log
general_log                    = 0

# ---------------------------------------------------------------------------
# Performance schema - keep on but limit memory
# ---------------------------------------------------------------------------
performance_schema             = ON
performance_schema_max_size    = 100M

[client]
default-character-set          = utf8mb4

[mysqldump]
default-character-set          = utf8mb4
quick
quote-names
max_allowed_packet             = 64M

[mysql]
default-character-set          = utf8mb4
