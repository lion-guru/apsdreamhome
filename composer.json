{
    "name": "apsdream/home",
    "description": "APS Dream Home - Real Estate CRM Platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "cboden/ratchet": "^0.4.4",
        "endroid/qr-code": "^6.0",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^7.0",
        "phpoffice/phpspreadsheet": "^5.10",
        "predis/predis": "^3.7",
        "symfony/messenger": "^7.4",
        "symfony/redis-messenger": "^7.4",
        "symfony/serializer": "^7.4",
        "tecnickcom/tcpdf": "^6.11",
        "twilio/sdk": "^8.11",
        "vlucas/phpdotenv": "^5.7",
        "zircote/swagger-php": "^7.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
