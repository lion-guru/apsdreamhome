# =============================================================================
# APS Dream Home - Production Environment Variables
# Copy this file to .env and fill in real values before deploying
# NEVER commit the real .env to version control
# =============================================================================

# ---- Application ----
APP_ENV=production
APP_DEBUG=false
APP_URL=https://apsdreamhome.com
APP_KEY=base64:CHANGEME-32-BYTES-RANDOM-BASE64
APP_VERSION=1.0.0

# ---- Database ----
DB_HOST=db
DB_PORT=3306
DB_DATABASE=apsdreamhome
DB_USERNAME=apsdream
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ---- Root DB password (for migrations / admin) ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_STRONG_PASSWORD

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Cache / Sessions ----
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# ---- WebSocket ----
WEBSOCKET_HOST=websocket
WEBSOCKET_PORT=8080

# ---- Mail (SMTP) ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@apsdreamhome.com
MAIL_PASSWORD=app-specific-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@apsdreamhome.com
MAIL_FROM_NAME="APS Dream Home"

# ---- Twilio (WhatsApp / SMS) ----
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ---- External services ----
GEMINI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Backups ----
BACKUP_RETENTION_DAYS=7

# ---- Timezone ----
TZ=Asia/Kolkata

# ---- Network ports ----
HTTP_PORT=80
HTTPS_PORT=443

# ---- Logging ----
LOG_CHANNEL=stderr

# ---- Feature flags ----
SKIP_CRON=
ENABLE_VOICE_AI=true
ENABLE_AI_CHATBOT=true
