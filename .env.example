# APS Dream Home - Environment Variables
# Copy this to .env for Docker / Codespaces

DB_HOST=db
DB_PORT=3307
DB_DATABASE=apsdreamhome
DB_USERNAME=root
DB_PASSWORD=

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

BASE_URL=http://localhost

REDIS_HOST=redis
REDIS_PORT=6379

TZ=Asia/Kolkata

# AI Service API Keys (leave empty, set in production environment)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SLACK_WEBHOOK_URL=
