# APS Dream Home Environment Variables - Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/apsdreamhome

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=apsdreamhome
DB_USER=root
DB_PASS=

# Security
APP_KEY=generate-with-php-artisan-key-generate
SESSION_DRIVER=file
SESSION_LIFETIME=7200

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp,pdf
UPLOAD_PATH=assets/uploads

# Cache
CACHE_DRIVER=file
CACHE_PREFIX=apsdreamhome

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=debug

# Timezone
APP_TIMEZONE=Asia/Kolkata

# Session Settings
SESSION_TIMEOUT=1800
REMEMBER_ME_DURATION=2592000

# Social Login - OAuth Credentials (get from respective developer consoles)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# AI / Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
SMS_NOTIFICATIONS_ENABLED=false
SMS_RECIPIENT_NUMBERS=

# Payment Gateway - Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true

# Payment Gateway - Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment Gateway - PhonePe
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# Payment Gateway - General
PAYMENT_SANDBOX=true

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_NAME=APS Dream Home
SMTP_FROM_EMAIL=
ADMIN_EMAIL=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=apsdreamhome_webhook_2026
WHATSAPP_API_VERSION=v18.0

# SMS Provider
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=APSDHM

# Development Settings
XDEBUG_ENABLED=true
XDEBUG_PORT=9003

# Cron Secret (used by HTTP cron endpoints)
CRON_SECRET=generate-secure-random-string

# Google Analytics 4
# Replace G-PLACEHOLDER with your real GA4 ID (G-XXXXXXXXXX) to enable tracking
GA4_MEASUREMENT_ID=G-PLACEHOLDER

# Web Push (VAPID) - Generate with: php scripts/generate_vapid_keys.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=PEM:config/vapid_private.key
VAPID_SUBJECT=mailto:admin@apsdreamhome.com

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=
STORAGE_LOCAL_URL=/uploads

# AWS S3 (optional, set STORAGE_DRIVER=s3 to use)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL_EXPIRY=60
AWS_S3_USE_PATH_STYLE=false

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json