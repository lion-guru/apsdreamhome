# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:your_32_char_random_string_here_generate_with_php_artisan_key_generate
APP_URL=https://yourdomain.com

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=apsdreamhome
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Redis Configuration
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mail Configuration (for production, use a service like SendGrid, Mailgun, or SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@apsdreamhome.com
MAIL_FROM_NAME="${APP_NAME}"

# File Storage
FILESYSTEM_DRIVER=local

# Storage Configuration (local or s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=
STORAGE_LOCAL_URL=/uploads

# AWS S3 / S3-Compatible Storage
# Set STORAGE_DRIVER=s3 to use S3 for all uploads and backups.
# For S3-compatible services (MinIO, DigitalOcean Spaces, Cloudflare R2)
# set AWS_ENDPOINT to the service URL and AWS_S3_USE_PATH_STYLE=true.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=apsdreamhome-uploads
AWS_ENDPOINT=
AWS_URL_EXPIRY=60
AWS_S3_USE_PATH_STYLE=false

# ═══════════════════════════════════════════════════════
# KYC / Identity Verification (NSDL + UIDAI)
# ═══════════════════════════════════════════════════════
# NSDL PAN Verification
# Get credentials from: https://tin-nsdl.com (TIN portal)
NSDL_API_KEY=
NSDL_API_SECRET=
NSDL_BASE_URL=https://tin-nsdl.com/api/v1
# Set to 'true' to use mock responses (safe for testing); 'false' for live API
NSDL_TEST_MODE=true

# UIDAI Aadhaar Verification
# Get credentials from: https://www.uidai.gov.in (developer portal)
UIDAI_API_KEY=
UIDAI_LICENSE_KEY=
UIDAI_BASE_URL=https://uidai.gov.in/api/v1
# Set to 'true' to use mock responses (safe for testing); 'false' for live API
UIDAI_TEST_MODE=true

# Pusher (if using websockets/realtime features)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# SSL/HTTPS (if terminating at load balancer or reverse proxy)
# Set to true if your application is behind a load balancer that handles SSL
SECURE_HANDLER=true
TRUSTED_PROXIES=*

# Session Configuration
SESSION_LIFETIME=120

# Memory Limit
PHP_MEMORY_LIMIT=256M

# Max Upload Size
PHP_UPLOAD_MAX_FILESIZE=20M
PHP_POST_MAX_SIZE=32M

# OPCache Settings
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_INTERNED_STRINGS_BUFFER=8
OPCACHE_MAX_ACCELERATED_FILES=4000
OPCACHE_REVALIDATE_FREQ=2
OPCACHE_FAST_SHUTDOWN=1