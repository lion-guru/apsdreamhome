# APS Dream Home Environment Variables
# Copy this file to .env and update values for your environment

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/apsdreamhome

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=apsdreamhome
DB_USER=root
DB_PASS=

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=80
SERVER_PROTOCOL=http

# Security
APP_KEY=your-secret-key-here
SESSION_DRIVER=file
SESSION_LIFETIME=7200

# Mail Configuration (for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@apsdreamhome.com
MAIL_FROM_NAME=APS Dream Home

# SMS Configuration (for notifications)
SMS_GATEWAY=
SMS_API_KEY=
SMS_SENDER_ID=

# Google OAuth (for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/apsdreamhome/auth/google/callback

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,web,pdf
UPLOAD_PATH=assets/uploads

# Cache Configuration
CACHE_DRIVER=file
CACHE_PREFIX=apsdreamhome

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Timezone
APP_TIMEZONE=Asia/Kolkata

# User Session Settings
SESSION_TIMEOUT=1800
REMEMBER_ME_DURATION=2592000

# API Configuration
API_RATE_LIMIT=60
API_TIMEOUT=30

# Development Settings
XDEBUG_ENABLED=true
XDEBUG_PORT=9003
BARBAGUIAN_ENABLED=true