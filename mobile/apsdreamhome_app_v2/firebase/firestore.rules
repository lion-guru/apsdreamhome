rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.role == 'admin';
    }
    
    function isAssociate() {
      return isAuthenticated() && 
        (request.auth.token.role == 'associate' || 
         request.auth.token.role == 'agent');
    }
    
    function isCustomer() {
      return isAuthenticated() && 
        request.auth.token.role == 'customer';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && 
        request.auth.uid == userId;
    }
    
    function isSameUser(userId) {
      return request.auth.uid == userId;
    }
    
    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isSameUser(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Colonies Collection - Public Read, Admin Write
    match /colonies/{colonyId} {
      allow read: if true; // Public
      allow write: if isAdmin();
    }
    
    // Plots Collection - Public Read, Admin/Associate Write
    match /plots/{plotId} {
      allow read: if true; // Public
      allow create: if isAdmin();
      allow update: if isAdmin() || isAssociate();
      allow delete: if isAdmin();
    }
    
    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.associateId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin() || 
        (resource.data.customerId == request.auth.uid && 
         resource.data.status == 'pending');
      allow delete: if isAdmin();
    }
    
    // Commissions Collection - Private to user and admin
    match /commissions/{commissionId} {
      allow read: if isAuthenticated() && (
        resource.data.beneficiaryId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin(); // Only admin/system can create commissions
    }
    
    // Payouts Collection
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Leads Collection - CRM
    match /leads/{leadId} {
      allow read: if isAuthenticated() && (
        resource.data.assignedTo == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.assignedTo == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Documents Collection
    match /documents/{documentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Gamification - Points, Badges
    match /gamification/{userId} {
      allow read: if isAuthenticated() && (
        isSameUser(userId) || isAdmin()
      );
      allow write: if isAdmin(); // Only system can update points
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Site Visits
    match /site_visits/{visitId} {
      allow read: if isAuthenticated() && (
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAssociate();
      allow update: if isAdmin() || 
        resource.data.agentId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    // MLM Genealogy - Private hierarchy
    match /genealogy/{userId} {
      allow read: if isAuthenticated() && (
        isSameUser(userId) || isAdmin()
      );
      allow write: if isAdmin(); // System managed
    }
    
    // System Settings - Admin only
    match /settings/{settingId} {
      allow read: if true; // Some public settings
      allow write: if isAdmin();
    }
    
    // Activity Logs - Admin only
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
