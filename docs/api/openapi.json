{
  "openapi": "3.0.3",
  "info": {
    "title": "APSDreamHome Mobile API",
    "description": "RESTful API for APSDreamHome mobile application",
    "version": "2.0.0",
    "contact": {
      "name": "APS Development Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost/apsdreamhome",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Property": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": ["active", "sold", "pending"]
          },
          "featured": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v2/mobile/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "token": {
                              "type": "string"
                            },
                            "user": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v2/mobile/properties": {
      "get": {
        "tags": ["Properties"],
        "summary": "Get all properties",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of properties",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Property"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/mobile/properties/featured": {
      "get": {
        "tags": ["Properties"],
        "summary": "Get featured properties",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of featured properties",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Property"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/mobile/properties/search": {
      "get": {
        "tags": ["Properties"],
        "summary": "Search properties",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results"
          }
        }
      }
    },
    "/api/v2/mobile/bookings": {
      "get": {
        "tags": ["Bookings"],
        "summary": "Get user bookings",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of bookings"
          }
        }
      }
    },
    "/api/v2/mobile/mlm/summary": {
      "get": {
        "tags": ["MLM"],
        "summary": "Get MLM dashboard summary",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "MLM summary data"
          }
        }
      }
    },
    "/api/v2/mobile/mlm/payouts": {
      "get": {
        "tags": ["MLM"],
        "summary": "Get MLM payouts",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of payouts"
          }
        }
      }
    },
    "/api/v2/mobile/mlm/incentives": {
      "get": {
        "tags": ["MLM"],
        "summary": "Get MLM incentives",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of incentives"
          }
        }
      }
    },
    "/api/v2/mobile/mlm/genealogy": {
      "get": {
        "tags": ["MLM"],
        "summary": "Get MLM genealogy tree",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Genealogy tree data"
          }
        }
      }
    },
    "/api/v2/mobile/mlm/business-breakdown": {
      "get": {
        "tags": ["MLM"],
        "summary": "Get MLM business breakdown",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Business breakdown data"
          }
        }
      }
    },
    "/api/v2/mobile/user/profile": {
      "get": {
        "tags": ["User"],
        "summary": "Get user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User profile data"
          }
        }
      }
    },
    "/api/v2/mobile/user/favorites": {
      "get": {
        "tags": ["User"],
        "summary": "Get user favorites",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of favorites"
          }
        }
      }
    },
    "/api/v2/mobile/user/documents": {
      "get": {
        "tags": ["User"],
        "summary": "Get user documents",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of documents"
          }
        }
      }
    },
    "/api/v2/mobile/user/notifications": {
      "get": {
        "tags": ["User"],
        "summary": "Get user notifications",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of notifications"
          }
        }
      }
    },
    "/api/v2/mobile/site-visit/slots": {
      "get": {
        "tags": ["Site Visits"],
        "summary": "Get available visit slots",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available time slots"
          }
        }
      }
    },
    "/api/v2/mobile/site-visit/my-visits": {
      "get": {
        "tags": ["Site Visits"],
        "summary": "Get user's site visits",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of site visits"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Authentication",
      "description": "User authentication endpoints"
    },
    {
      "name": "Properties",
      "description": "Property listing and search endpoints"
    },
    {
      "name": "Bookings",
      "description": "Booking management endpoints"
    },
    {
      "name": "MLM",
      "description": "Multi-Level Marketing endpoints"
    },
    {
      "name": "User",
      "description": "User profile and preferences endpoints"
    },
    {
      "name": "Site Visits",
      "description": "Site visit scheduling endpoints"
    }
  ]
}
