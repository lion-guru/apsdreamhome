{
  "project": "APS Dream Home",
  "project_root": "C:\\xampp\\htdocs\\apsdreamhome",
  "ollama": {
    "enabled": true,
    "base_url": "http://localhost:11434",
    "model": "qwen2.5:7b",
    "fallback_model": "qwen2.5:3b",
    "timeout_ms": 120000
  },
  "agents": [
    {
      "id": "backend",
      "name": "Backend Engineer",
      "role": "php_backend",
      "description": "PHP/MVC backend development, controller fixes, service layer improvements, SQL fixes",
      "priority": 1,
      "concurrent_tasks": 3,
      "tools": ["filesystem", "bash", "grep", "sequential_thinking"]
    },
    {
      "id": "frontend",
      "name": "Frontend Engineer",
      "role": "flutter_frontend",
      "description": "Flutter UI/UX improvements, page wiring, responsive fixes, widget development",
      "priority": 2,
      "concurrent_tasks": 3,
      "tools": ["filesystem", "bash", "grep"]
    },
    {
      "id": "qa",
      "name": "QA Engineer",
      "role": "testing",
      "description": "E2E test execution, regression testing, bug verification, PHP syntax checking",
      "priority": 1,
      "concurrent_tasks": 2,
      "tools": ["bash", "playwright", "sequential_thinking"]
    },
    {
      "id": "security",
      "name": "Security Engineer",
      "role": "security_audit",
      "description": "SQL injection audits, XSS checks, CSRF verification, auth hardening, tenant isolation",
      "priority": 1,
      "concurrent_tasks": 2,
      "tools": ["filesystem", "bash", "grep", "sequential_thinking"]
    },
    {
      "id": "devops",
      "name": "DevOps Engineer",
      "role": "infrastructure",
      "description": "Build automation, APK builds, deployment checks, cron scripts, DB migrations",
      "priority": 3,
      "concurrent_tasks": 2,
      "tools": ["bash", "filesystem", "sequential_thinking"]
    },
    {
      "id": "architecture",
      "name": "Architecture Analyst",
      "role": "codebase_analysis",
      "description": "Deep codebase analysis, dead code detection, architecture improvements, dependency mapping",
      "priority": 2,
      "concurrent_tasks": 2,
      "tools": ["filesystem", "bash", "grep", "research"]
    },
    {
      "id": "docs",
      "name": "Documentation Engineer",
      "role": "documentation",
      "description": "AGENTS.md updates, changelog, documentation generation, lesson capture",
      "priority": 3,
      "concurrent_tasks": 1,
      "tools": ["filesystem", "bash", "sequential_thinking"]
    }
  ],
  "scheduler": {
    "mode": "continuous",
    "cycle_interval_ms": 30000,
    "max_cycles_per_run": 999,
    "work_hours_start": 8,
    "work_hours_end": 23,
    "auto_discovery_enabled": true,
    "priority_threshold": "medium"
  },
  "e2e_tests": {
    "command": "node testing/visual_tests/E2E_MASTER_TEST.mjs",
    "timeout_ms": 300000,
    "expected_pass_rate": 0.99
  },
  "php_syntax": {
    "command": "php -l",
    "recursive": true,
    "exclude_dirs": ["_archive", "agentic_dev_system", "vendor"]
  },
  "task_sources": [
    "AGENTS.md pending tasks",
    "git diff --stat HEAD~10",
    "TODO markers in codebase",
    "PHP syntax errors",
    "E2E test failures",
    "dead code detection",
    "security audit findings",
    "performance analysis"
  ],
  "reporting": {
    "log_file": "agentic_dev_system/logs/agent_heartbeat.log",
    "report_interval_cycles": 5,
    "alert_on_failure": true,
    "max_log_size_mb": 50
  }
}
