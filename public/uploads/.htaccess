# Prevent direct access to uploaded PHP files (Apache 2.4 syntax)
<FilesMatch '\.(php|phtml|pht|php3|php4|php5|phpt)$'>
    Require all denied
</FilesMatch>

# Block direct access to .htaccess and sensitive files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Allow image access
<FilesMatch '\.(jpg|jpeg|png|gif|webp)$'>
    Require all granted
</FilesMatch>
